{
  "manifest_version": 3,
  "name": "Page Connect",
  "version": "1.3.0",
  "description": "Opens a URL at a precise time, and watches retail product pages to add an item to your cart when it's available.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "windows",
    "power",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Page Connect",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
